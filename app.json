{
  "expo": {
    "name": "PawRok",
    "slug": "pawrok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawrok.mobile",
      "config": {
        "googleMapsApiKey": "AIzaSyC9TsMrG93WfhiU8aSAeFquHrAl-XfTqbI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PawRok needs your location to show nearby services and lost & found alerts.",
        "NSLocationAlwaysUsageDescription": "PawRok needs your location for radius-based alerts.",
        "NSCameraUsageDescription": "PawRok needs camera access to upload pet photos.",
        "NSPhotoLibraryUsageDescription": "PawRok needs photo library access to upload pet photos."
      }
    },
    "android": {
      "package": "com.pawrok.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9TsMrG93WfhiU8aSAeFquHrAl-XfTqbI"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PawRok to access your photos to attach images and videos to messages.",
          "cameraPermission": "Allow PawRok to use the camera to take photos for messages."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PawRok to use your location."
        }
      ]
    ],
    "scheme": "pawrok",
    "owner": "jmcarizons-organization",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "308b30fa-5739-4961-9dca-8c37feddd5e8"
      }
    }
  }
}
